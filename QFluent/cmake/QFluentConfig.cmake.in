@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# 查找 Qt 依赖
find_dependency(Qt@QT_VERSION_MAJOR@ COMPONENTS Core Widgets Svg Xml)

# 包含导出的目标
include("${CMAKE_CURRENT_LIST_DIR}/QFluentTargets.cmake")

# 检查目标是否存在
check_required_components(QFluent)

# 便捷变量
# 安装后头文件被摊平到 include/QFluent/ 下，而源码中同时存在两种包含风格：
#   #include "QFluent/PushButton.h"  -> 需要 include/
#   #include "Theme.h"               -> 需要 include/QFluent/
# 所以两个目录都要暴露。正常使用 QFluent::QFluent 目标时无需手动设置。
set(QFLUENT_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR_FOR_CONFIG@")
set(QFLUENT_INCLUDE_DIRS
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR_FOR_CONFIG@"
    "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR_FOR_CONFIG@/QFluent"
)
set(QFLUENT_LIBRARIES QFluent::QFluent)
